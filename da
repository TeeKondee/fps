--// ระบบบังคับจำกัด FPS แบบล็อกค่าจริง (Strict FPS Limiter)
local isTesting = false
local targetFps = 60

startButton.MouseButton1Click:Connect(function()
	isTesting = not isTesting
	if isTesting then
		targetFps = selectedFps
		startButton.Text = "หยุดทดลอง FPS"
		startButton.BackgroundColor3 = Color3.fromRGB(231, 76, 60)
		statusLabel.Text = "สถานะ: ล็อก FPS ไว้ที่ " .. targetFps .. " ตรงๆ"
		statusLabel.TextColor3 = Color3.fromRGB(46, 204, 113)
	else
		startButton.Text = "เริ่ม FPS ทดลอง"
		startButton.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
		statusLabel.Text = "สถานะ: ปิดการทดลอง (FPS ปกติ)"
		statusLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
	end
end)

-- คำนวณและจำกัดเฟรมเรตแบบเสถียร พร้อมวัด FPS จริงโชว์ให้เห็นจะๆ
local accumulator = 0
local frameCount = 0
local timer = 0

RunService.RenderStepped:Connect(function(dt)
	-- คำนวณ FPS จริงที่เกิดขึ้นในขณะนั้น
	frameCount = frameCount + 1
	timer = timer + dt
	if timer >= 0.5 then -- อัปเดตตัวเลขทุกๆ ครึ่งวิ
		local currentFps = math.floor((frameCount / timer) + 0.5)
		realFpsLabel.Text = "FPS จริงตอนนี้: " .. currentFps .. " FPS"
		if isTesting then
			realFpsLabel.TextColor3 = Color3.fromRGB(241, 196, 15)
		else
			realFpsLabel.TextColor3 = Color3.fromRGB(46, 204, 113)
		end
		frameCount = 0
		timer = 0
	end

	-- ถ้ากดเปิดใช้งาน ให้บล็อกรอบเรนเดอร์ทันทีตามค่าที่เลือก
	if isTesting then
		local frameInterval = 1 / targetFps
		accumulator = accumulator + dt
		while accumulator < frameInterval do
			local restTime = frameInterval - accumulator
			if restTime > 0.001 then
				task.wait(restTime)
			else
				RunService.RenderStepped:Wait()
			end
			-- ป้องกันลูปค้างเผื่อกรณีฉุกเฉิน
			break
		end
		accumulator = accumulator - frameInterval
		if accumulator < 0 then accumulator = 0 end
	else
		accumulator = 0
	end
end)
